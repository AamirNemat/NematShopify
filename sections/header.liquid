<header class="header" role="banner">
  <div class="page-width header__wrapper">
    <a href="/" class="header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="200"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span class="header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" role="navigation" aria-label="{{ 'sections.header.navigation' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="header__nav-link {% if link.active %}header__nav-link--active{% endif %}">
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__action" aria-label="{{ 'sections.header.search' | t }}">
        {% render 'icon-search' %}
      </a>
      <a href="{{ routes.cart_url }}" class="header__action header__cart" aria-label="{{ 'sections.header.cart' | t }}">
        {% render 'icon-cart' %}
        <span class="header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
