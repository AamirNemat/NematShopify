{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.announcement_bar.label' | t }}">
    <div class="page-width">
      <p class="announcement-bar__message">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.settings.text.label",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.settings.link.label"
    }
  ]
}
{% endschema %}
