<section class="hero-banner" style="{% if section.settings.image %}background-image: url('{{ section.settings.image | image_url: width: 1920 }}');{% endif %}">
  <div class="page-width hero-banner__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-banner__button button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero_banner.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero_banner.settings.image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero_banner.settings.heading.label",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.hero_banner.settings.subheading.label",
      "default": "Discover our latest collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero_banner.settings.button_label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero_banner.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_banner.presets.name"
    }
  ]
}
{% endschema %}
